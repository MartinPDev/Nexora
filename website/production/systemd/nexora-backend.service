[Unit]
Description=Nexora Website Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/nexora/website_backend
ExecStart=/var/www/nexora/website_backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
